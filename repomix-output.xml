                                            <button onClick={() => navigate(`/admin/products/${item.sanPhamID}`)} style={styles.btnManage}>Quản lý</button>
                                            
                                            {item.trangThai ? (
                                                <button onClick={() => handleToggleStatus(item)} style={styles.btnDisable}>
