    public async Task<OrderDetailResponse?> GetDetailAsync(
        int khachHangId,
        int donHangId)
    {
        var donHang =
            await _unitOfWork.DonHangs
                .GetDetailAsync(donHangId, khachHangId);

        if (donHang == null)
            return null;

        return new OrderDetailResponse
        {
