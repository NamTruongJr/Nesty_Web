                                            ) : (
                                                <button onClick={() => handleToggleStatus(item)} style={styles.btnEnable}>
                                                    Kích hoạt
                                                </button>
                                            )}
                                        </div>
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    );
}

